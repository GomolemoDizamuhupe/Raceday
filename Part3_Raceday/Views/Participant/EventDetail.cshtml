@model Part3_Raceday.Models.EventDetailViewModel
@{
    ViewData["Title"] = Model.Event.Name;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Events" class="btn btn-link ps-0">&larr; Back to events</a>

<div class="card mb-5">
    <div class="event-banner event-banner-lg">
        @if (!string.IsNullOrEmpty(Model.Event.BannerUrl))
        {
            <img src="@Model.Event.BannerUrl" class="event-banner-media" alt="@Model.Event.Name banner" />
        }
        else
        {
            <div class="event-banner-fallback" role="img" aria-label="No banner uploaded"></div>
        }
        <div class="event-bib">
            <partial name="_DateBib" model="Model.Event.EventDate" />
        </div>
    </div>
    <div class="card-body pt-5">
        <h2>@Model.Event.Name</h2>
        <p class="mb-1"><strong>Location:</strong> @Model.Event.Location</p>
        @if (!string.IsNullOrEmpty(Model.Event.EventType))
        {
            <p class="mb-1"><strong>Type:</strong> @Model.Event.EventType</p>
        }
        <p class="mt-3 mb-0">@Model.Event.Description</p>
    </div>
</div>

<h4 class="mb-3">Categories</h4>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">No categories have been added to this event yet. Check back soon.</div>
}

<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var c in Model.Categories)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@c.Name</h5>
                    <p class="mb-1">@c.DistanceKm km</p>
                    <p class="text-muted">Max @c.MaxParticipants participants</p>

                    @if (Model.Routes.TryGetValue(c.CategoryId, out var route))
                    {
                        <hr />
                        <p class="mb-1"><strong>Route</strong></p>
                        <p class="mb-1 small">@route.StartPoint &rarr; @route.EndPoint</p>
                        @if (route.ElevationGainM != null)
                        {
                            <p class="mb-1 small">Elevation gain: @route.ElevationGainM m</p>
                        }
                        @if (!string.IsNullOrEmpty(route.MapUrl))
                        {
                            <p class="small"><a href="@route.MapUrl" target="_blank" rel="noopener">View map</a></p>
                        }
                    }

                    <form asp-action="Enter" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                        <button class="btn btn-primary w-100">Enter event</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
