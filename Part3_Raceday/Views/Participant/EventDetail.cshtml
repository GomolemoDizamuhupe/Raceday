@model Part3_Raceday.Models.EventDetailViewModel
@{
    ViewData["Title"] = Model.Event.Name;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Events" class="btn btn-link ps-0">&larr; Back to events</a>

<div class="card shadow-sm mb-4">
    @if (!string.IsNullOrEmpty(Model.Event.BannerUrl))
    {
        <img src="@Model.Event.BannerUrl" class="card-img-top" style="max-height:300px;object-fit:cover" alt="@Model.Event.Name banner" />
    }
    <div class="card-body">
        <h2>@Model.Event.Name</h2>
        <p class="mb-1"><strong>Date:</strong> @Model.Event.EventDate.ToString("dd MMMM yyyy")</p>
        <p class="mb-1"><strong>Location:</strong> @Model.Event.Location</p>
        @if (!string.IsNullOrEmpty(Model.Event.EventType))
        {
            <p class="mb-1"><strong>Type:</strong> @Model.Event.EventType</p>
        }
        <p class="mt-3">@Model.Event.Description</p>
    </div>
</div>

<h4 class="mb-3">Categories</h4>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">No categories have been added to this event yet.</div>
}

<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var c in Model.Categories)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@c.Name</h5>
                    <p class="mb-1">@c.DistanceKm km</p>
                    <p class="text-muted">Max @c.MaxParticipants participants</p>
                    <form asp-action="Enter" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                        <button class="btn btn-success w-100">Enter Event</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>