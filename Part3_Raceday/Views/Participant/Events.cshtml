@model Part3_Raceday.Models.EventsListViewModel
@{
    ViewData["Title"] = "Upcoming Events";
}

<h2 class="mb-3">Upcoming events</h2>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="get" class="row g-2 mb-5">
    <div class="col-md-4">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by name or description" />
    </div>
    <div class="col-md-3">
        <input name="location" value="@Model.Location" class="form-control" placeholder="Location" />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All event types</option>
            @foreach (var t in Model.Types)
            {
                <option value="@t" selected="@(t == Model.Type)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Filter</button>
    </div>
</form>

@if (!Model.Events.Any() && Model.Error == null)
{
    <div class="alert alert-info">No upcoming events match your search. Try a different name or location.</div>
}

<div class="row row-cols-1 row-cols-md-3 g-5">
    @foreach (var e in Model.Events)
    {
        <div class="col">
            <div class="card event-card h-100">
                <div class="event-banner">
                    @if (!string.IsNullOrEmpty(e.BannerUrl))
                    {
                        <img src="@e.BannerUrl" class="event-banner-media" alt="@e.Name banner" />
                    }
                    else
                    {
                        <div class="event-banner-fallback" role="img" aria-label="No banner uploaded"></div>
                    }
                    <div class="event-bib">
                        <partial name="_DateBib" model="e.EventDate" />
                    </div>
                </div>
                <div class="card-body pt-5">
                    <h5 class="card-title">@e.Name</h5>
                    <p class="mb-2 text-muted">@e.Location</p>
                    @if (!string.IsNullOrEmpty(e.EventType))
                    {
                        <span class="badge bg-dark">@e.EventType</span>
                    }
                    @if (e.DistanceKm != null)
                    {
                        <span class="badge bg-secondary">@e.DistanceKm km</span>
                    }
                    <a asp-action="EventDetail" asp-route-id="@e.EventId" class="btn btn-primary btn-sm mt-3 d-block">View details</a>
                </div>
            </div>
        </div>
    }
</div>
