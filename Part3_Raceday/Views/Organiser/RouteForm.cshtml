@model Part3_Raceday.Models.RouteFormViewModel
@{
    ViewData["Title"] = Model.RouteId == 0 ? "Add route" : "Edit route";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">@ViewData["Title"]</h2>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="SaveRoute" method="post">
            <input type="hidden" asp-for="RouteId" />
            <input type="hidden" asp-for="CategoryId" />
            <input type="hidden" asp-for="EventId" />

            <div class="mb-3">
                <label asp-for="StartPoint" class="form-label"></label>
                <input asp-for="StartPoint" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="EndPoint" class="form-label"></label>
                <input asp-for="EndPoint" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ElevationGainM" class="form-label"></label>
                <input asp-for="ElevationGainM" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="MapUrl" class="form-label"></label>
                <input asp-for="MapUrl" class="form-control" placeholder="https://..." />
            </div>

            <button class="btn btn-primary">Save route</button>
            <a asp-action="Categories" asp-route-id="@Model.EventId" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}