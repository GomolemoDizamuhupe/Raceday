@model Part3_Raceday.Models.EventFormViewModel
@{
    ViewData["Title"] = Model.EventId == 0 ? "New event" : "Edit event";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-3">@ViewData["Title"]</h2>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="SaveEvent" method="post">
            <input type="hidden" asp-for="EventId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="">Select type</option>
                        <option>Road Run</option>
                        <option>Trail Run</option>
                        <option>Cycling</option>
                        <option>Walk</option>
                        <option>Triathlon</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" class="form-control" />
                </div>
            </div>

            <button class="btn btn-primary">Save event</button>
            <a asp-action="Events" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}