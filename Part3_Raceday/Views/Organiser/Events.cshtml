@model List<Part3_Raceday.Models.ApiEvent>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My Events</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">+ New event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <table class="table align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Type</th>
                <th>Distance</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Name</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.Location</td>
                    <td>@e.EventType</td>
                    <td>@(e.DistanceKm != null ? e.DistanceKm + " km" : "")</td>
                    <td class="text-end">
                        <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-outline-success btn-sm">Enrolments</a>
                        <a asp-action="Categories" asp-route-id="@e.EventId" class="btn btn-outline-primary btn-sm">Categories</a>
                        <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-outline-dark btn-sm">Edit</a>
                        <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this event?');">
                            <button class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}