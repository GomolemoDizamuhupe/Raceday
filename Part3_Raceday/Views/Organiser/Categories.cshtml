@model Part3_Raceday.Models.CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
}

<a asp-action="Events" class="btn btn-link ps-0">&larr; Back to my events</a>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Event.Name: categories</h2>
    <a asp-action="CreateCategory" asp-route-eventId="@Model.Event.EventId" class="btn btn-primary">+ Add category</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">No categories yet. Add one so participants can enter this event.</div>
}
else
{
    <table class="table align-middle">
        <thead class="table-dark">
            <tr><th>Name</th><th>Distance</th><th>Max participants</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.DistanceKm km</td>
                    <td>@c.MaxParticipants</td>
                    <td class="text-end">
                        <a asp-action="EditRoute" asp-route-categoryId="@c.CategoryId" asp-route-eventId="@Model.Event.EventId"
                           class="btn btn-outline-primary btn-sm">Route</a>
                        <a asp-action="EditCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId"
                           class="btn btn-outline-dark btn-sm">Edit</a>
                        <form asp-action="DeleteCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId"
                              method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                            <button class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}